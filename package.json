{
  "name": "evernote-replica-api",
  "version": "0.1.0",
  "private": true,
  "description": "REST API for Evernote Replica (Express, MongoDB, Zod)",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "google-auth-library": "^11.3.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.1",
    "nodemailer": "^10.6.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  }
}
