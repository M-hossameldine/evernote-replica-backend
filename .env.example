# --- Server ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Number of proxies in front of the app. Railway: 1
TRUST_PROXY=0

# --- Database (MongoDB Atlas connection string) ---
# Paste the string from Atlas (Connect > Drivers) and replace <db_password>
MONGODB_URI=mongodb+srv://<user>:<db_password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=<cluster>
# Database to use on the cluster (overrides any name in the URI)
MONGODB_DB_NAME=evernote-replica-dev

# --- Frontend ---
# Used to build links in emails (e.g. password reset)
APP_URL=http://localhost:5173
# Comma-separated origins allowed to call the API with credentials
CORS_ORIGINS=http://localhost:5173

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12
# Defaults: secure=false/samesite=lax in development, secure=true/samesite=none in production
COOKIE_SECURE=
COOKIE_SAMESITE=

# --- Google sign-in (OAuth client id from Google Cloud Console) ---
GOOGLE_CLIENT_ID=

# --- Email (any SMTP provider). Leave SMTP_HOST empty to log emails in development ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Evernote Replica <no-reply@example.com>
PASSWORD_RESET_TTL_MINUTES=60

# --- Rate limiting (auth routes) ---
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
PASSWORD_RESET_RATE_LIMIT_MAX=5

# --- API docs at /docs and /openapi.json ---
DOCS_ENABLED=true

# --- Seed script (npm run db:seed), development only ---
SEED_DEMO_EMAIL=demo@evernote-replica.local
SEED_DEMO_PASSWORD=
